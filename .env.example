# Copy to .env and fill in values. Every variable here is validated in src/env.ts.

# Local Postgres from compose.yaml (`pnpm db:up`).
DATABASE_URL="postgresql://hanahire:hanahire@localhost:5432/hanahire"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# OAuth apps. See "Setting up sign-in" in README.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Comma-separated emails allowed to sign in.
ALLOWED_EMAILS="you@example.com"

# development | test | production (Next.js sets this automatically)
# NODE_ENV=development
